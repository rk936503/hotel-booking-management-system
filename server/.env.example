# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection URL (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/hotel_booking?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Allowed Client Origin (for CORS)
CLIENT_URL="http://localhost:5173"

# Business Logic Parameters
TAX_RATE=12
BOOKING_HOLD_DURATION_MINUTES=15
PAYMENT_GATEWAY_MODE="simulated"
